# =============================================================================
# HEALTH_GEN_AI configuration. Copy to `.env` (which is git-ignored):
#     cp .env.example .env
# Nothing in the code hard-codes a key: everything is read from here.
# =============================================================================

# --- LLM provider switch -----------------------------------------------------
# openai  -> uses OPENAI_API_KEY + OPENAI_MODEL / OPENAI_EMBED_MODEL
# groq    -> uses GROQ_API_KEY + GROQ_MODEL (fast hosted open models, e.g. gpt-oss-120b). Groq has no
#            embeddings API, so RAG embeddings default to "local" (FastEmbed:
#            a ~70 MB model on the CPU, downloaded automatically on first use).
# ollama  -> uses a local Ollama server (brew install ollama; free, private)
# mock    -> offline dev/test mode: no LLM at all, agents use deterministic
#            templates and a lexical hashing embedder. Good for learning the
#            plumbing without any model running.
LLM_PROVIDER=ollama

# Embeddings provider for RAG: local | openai | ollama | mock. Leave empty to
# follow LLM_PROVIDER (groq -> local). After changing it: `python -m core.rag --rebuild`.
EMBEDDINGS_PROVIDER=
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Groq (only needed when LLM_PROVIDER=groq). Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI (only needed when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Ollama (only needed when LLM_PROVIDER=ollama)
#   ollama pull llama3.1:8b && ollama pull nomic-embed-text
#   8 GB Mac? Use OLLAMA_MODEL=llama3.2:3b (~2 GB) so Neo4j + Docker still fit in RAM.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Sampling temperature for all agent calls (low = more repeatable drafts)
LLM_TEMPERATURE=0.1

# --- Neo4j (matches docker-compose.yml) --------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local-only
# Neo4j JVM heap (docker-compose). 1g is plenty for ~250 Synthea patients.
NEO4J_HEAP_MAX=1g

# --- Pipeline knobs -------------------------------------------------------------
# Random seed used by every generator / model so runs are reproducible.
SEED=42
# Only claims from the last N years of each Synthea history are kept.
CLAIM_YEARS=4

# --- API / UI ------------------------------------------------------------------
API_PORT=8000
# Where the Next.js server proxies /api/* to (see ui/next.config.mjs)
API_URL=http://localhost:8000
